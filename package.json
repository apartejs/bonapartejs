{
  "name": "bonapartejs",
  "version": "0.0.0",
  "description": "Local-first coding agent — Electron + apartéJS + managed llama.cpp, with per-conversation KV cache persistence",
  "private": true,
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @aparte/bonaparte-app dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint packages plugins --no-error-on-unmatched-pattern --max-warnings 0"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^23.1.1",
    "eslint": "^9.0.0",
    "nx": "^23.1.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "nx"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
