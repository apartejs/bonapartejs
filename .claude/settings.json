{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec nx *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(node --test *)",
      "Bash(node packages/cli/dist/cli.js *)",
      "Bash(npm view *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git stash list *)",
      "Bash(git worktree list *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(gh issue create *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "PowerShell(pnpm install *)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck *)",
      "PowerShell(pnpm build *)",
      "PowerShell(pnpm --filter *)",
      "PowerShell(pnpm exec vitest *)",
      "PowerShell(pnpm exec playwright *)",
      "PowerShell(pnpm exec eslint *)",
      "PowerShell(pnpm exec tsc *)",
      "PowerShell(pnpm exec nx *)",
      "PowerShell(npx vitest *)",
      "PowerShell(npx playwright *)",
      "PowerShell(node --test *)",
      "PowerShell(node packages/cli/dist/cli.js *)",
      "PowerShell(npm view *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git ls-tree *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)",
      "PowerShell(git stash list *)",
      "PowerShell(git worktree list *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh release list *)",
      "PowerShell(gh release view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-command.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-gitignore.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
