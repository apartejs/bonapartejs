{
  "name": "@aparte/bonaparte-shared",
  "version": "0.1.0",
  "description": "bonaparte — contracts shared by the core, the app and the plugins: modes, effects, IPC, manifests",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "keywords": [
    "llama.cpp",
    "local-llm",
    "coding-agent",
    "kv-cache",
    "electron",
    "aparte"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:shared"
    ]
  }
}
