{
  "name": "@aparte/bonaparte",
  "version": "1.0.0",
  "description": "bonaparte — `npx @aparte/bonaparte` launches the app; `bonaparte doctor` says what the machine has for the built-in engine",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "keywords": [
    "bonaparte",
    "llama.cpp",
    "coding-agent",
    "aparte"
  ],
  "type": "module",
  "bin": {
    "bonaparte": "./dist/cli.js"
  },
  "files": [
    "dist",
    "app"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../app/scripts/prepare-vcruntime.mjs && node scripts/assemble-app.mjs",
    "postpack": "node scripts/assemble-app.mjs --clean"
  },
  "dependencies": {
    "@aparte/core": "1.15.0",
    "@aparte/locales": "1.15.0",
    "@aparte/plugin-approval": "1.15.0",
    "@aparte/plugin-ask-user": "1.15.0",
    "@aparte/plugin-cards": "1.15.0",
    "@aparte/plugin-diff": "1.15.0",
    "@aparte/plugin-model-selector": "1.15.0",
    "@aparte/plugin-shiki": "1.15.0",
    "@aparte/plugin-streaming-markdown": "1.15.0",
    "@aparte/plugin-subagents": "1.15.0",
    "@aparte/plugin-triggers": "1.15.0",
    "@aparte/react": "1.15.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^45.3.2",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aparte/bonaparte-core": "workspace:*",
    "@aparte/bonaparte-shared": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:cli"
    ]
  }
}
