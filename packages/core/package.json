{
  "name": "@aparte/bonaparte-core",
  "version": "1.0.0",
  "description": "bonaparte — the core: engine, journal, KV memory, agent loop, tools, permissions. Pure Node, no Electron.",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "keywords": [
    "llama.cpp",
    "local-llm",
    "coding-agent",
    "kv-cache",
    "electron",
    "aparte"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./plugin-child": {
      "types": "./dist/plugin-child.d.ts",
      "import": "./dist/plugin-child.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aparte/bonaparte-shared": "workspace:*",
    "@aparte/engine": "1.13.0",
    "@aparte/plugin-diff": "1.13.0",
    "@aparte/provider-openai-compat": "1.13.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "undici": "^7.30.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aparte/core": "1.13.0",
    "@huggingface/jinja": "0.5.13",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:core"
    ]
  }
}
