{
  "name": "@aparte/bonaparte-app",
  "version": "1.0.0",
  "description": "bonaparte — the Electron app: main process, preload, React window",
  "private": true,
  "license": "MIT",
  "author": "Paul Richez",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "pnpm -w build && playwright test",
    "dist": "node scripts/prepare-vcruntime.mjs && electron-builder --publish never",
    "dist:dir": "node scripts/prepare-vcruntime.mjs && electron-builder --dir --publish never",
    "dist:store": "node scripts/prepare-vcruntime.mjs && electron-builder --win appx --publish never"
  },
  "dependencies": {
    "@aparte/core": "1.15.1",
    "@aparte/locales": "1.15.1",
    "@aparte/plugin-approval": "1.15.1",
    "@aparte/plugin-ask-user": "1.15.1",
    "@aparte/plugin-cards": "1.15.1",
    "@aparte/plugin-diff": "1.15.1",
    "@aparte/plugin-model-selector": "1.15.1",
    "@aparte/plugin-shiki": "1.15.1",
    "@aparte/plugin-streaming-markdown": "1.15.1",
    "@aparte/plugin-subagents": "1.15.1",
    "@aparte/plugin-triggers": "1.15.1",
    "@aparte/react": "1.15.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aparte/bonaparte-core": "workspace:*",
    "@aparte/bonaparte-plugin-browser": "workspace:*",
    "@aparte/bonaparte-plugin-sdk": "workspace:*",
    "@aparte/bonaparte-plugin-terminal": "workspace:*",
    "@aparte/bonaparte-plugin-web-search": "workspace:*",
    "@aparte/bonaparte-shared": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.8",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:app"
    ]
  }
}
