  "description": "bonaparte — authoring surface for plugins (contexts, view props, helpers)",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/plugin-sdk"
  },
