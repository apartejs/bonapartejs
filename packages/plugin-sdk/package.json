{
  "name": "@aparte/bonaparte-plugin-sdk",
  "version": "0.1.0",
  "description": "bonaparte — what a plugin author imports: the manifest, the context of its Node half, definePlugin",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "keywords": [
    "bonaparte",
    "plugin",
    "coding-agent",
    "aparte"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aparte/bonaparte-shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "nx": {
    "tags": [
      "scope:plugin-sdk"
    ]
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
