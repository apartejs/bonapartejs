{
  "name": "@aparte/bonaparte-plugin-sdk",
  "version": "0.1.0",
  "description": "bonaparte — authoring surface for plugins (contexts, view props, helpers)",
  "license": "MIT",
  "author": "Paul Richez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apartejs/bonapartejs.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/apartejs/bonapartejs#readme",
  "bugs": {
    "url": "https://github.com/apartejs/bonapartejs/issues"
  },
  "keywords": [
    "llama.cpp",
    "local-llm",
    "coding-agent",
    "kv-cache",
    "electron",
    "aparte"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aparte/bonaparte-shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.35.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "react": "^19.2.8",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "nx": {
    "tags": [
      "scope:plugin-sdk"
    ]
  }
}
